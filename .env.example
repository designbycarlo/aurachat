# ═══════════════════════════════════════════════════════════
# AuraChat - AI Agent Environment Configuration
# ═══════════════════════════════════════════════════════════

# OpenRouter API Key (used by the AI Agent)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# OpenRouter Model ID (defaults to a free model if not set)
# Free models end with ":free" and cost $0 to use.
# Examples:
#   openai/gpt-oss-20b:free
#   google/gemma-4-31b-it:free
#   nvidia/nemotron-3-super-120b-a12b:free
# Browse all available models: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Automatic model failover is enabled by default.
# If the preferred model fails, errors, or times out (idle for 60s),
# AuraChat automatically switches to the next available free model.
# You can adjust the timeout (in ms) with:
# OPENROUTER_TIMEOUT_MS=60000

# ═══════════════════════════════════════════════════════════
# Database (user accounts, sessions, saved reports)
# ─────────────────────────────────────────────────────────────
# Production uses a standard Postgres supplied via DATABASE_URL. On Render,
# DATABASE_URL is auto-injected from the Render-managed Postgres database
# configured in render.yaml.
#
# The app uses `pg` against DATABASE_URL and has no host-specific code, so any
# Postgres works (Render, Supabase, Railway, Neon, local, etc.).
#
# Leave DATABASE_URL UNSET for local dev — AuraChat then falls back to an
# embedded PGlite Postgres (real Postgres in WASM, no install required):
# DATABASE_URL=postgres://user:***@localhost:5432/aurachat   # self-hosted example
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Add your OpenRouter API key (free at https://openrouter.ai/keys)
# 3. Run: npm run server
# ═══════════════════════════════════════════════════════════