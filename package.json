{
  "name": "aurachat",
  "version": "1.0.0",
  "description": "AuraChat — AI SEO/AEO analyzer using OpenRouter (Cloudflare Pages build)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "dev": "node server.js",
    "build": "echo \"Static Pages project - no build step required\"",
    "icons": "node generate-icons.js",
    "test": "node test/store.test.js",
    "migrate": "node migrate.js",
    "pages:dev": "wrangler pages dev public --d1 DB=./.wrangler/state/d1/aurachat.db --port 8788",
    "pages:deploy": "wrangler pages deploy public",
    "pages:migrate:local": "wrangler d1 migrations apply aurachat --local",
    "pages:migrate:remote": "wrangler d1 migrations apply aurachat --remote"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.27",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "ai": "^7.0.48",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "geist": "^1.7.2",
    "sharp": "^0.35.3",
    "wrangler": "^4.119.0"
  }
}
